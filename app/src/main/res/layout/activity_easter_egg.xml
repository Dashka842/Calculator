<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Градиентный фон -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_background" />

    <!-- Начальный экран с большим текстом -->
    <TextView
        android:id="@+id/tvSecretMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="СЕКРЕТНАЯ\nКОМБИНАЦИЯ\nАКТИВИРОВАНА!"
        android:textColor="#FFD700"
        android:textSize="42sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_gravity="center"
        android:visibility="visible" />

    <!-- Основной контент (изначально скрыт) -->
    <ScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="invisible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Заголовок Made by -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Made by Дара"
                android:textSize="36sp"
                android:textStyle="bold"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:visibility="invisible" />

            <!-- Подзаголовок -->
            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ты нашёл секретную страницу!"
                android:textColor="#CCCCCC"
                android:textSize="16sp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="32dp"
                android:visibility="invisible" />

            <!-- Блок 1: Основная информация -->
            <LinearLayout
                android:id="@+id/blockInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/gradient_card"
                android:padding="24dp"
                android:layout_marginBottom="16dp"
                android:visibility="invisible"
                android:elevation="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋 ПАСПОРТ ИЗДЕЛИЯ"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Продукт: Калькулятор\nВерсия: 1.0 (стабильная... наверное)\nРазработчик: Дара"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:lineSpacingExtra="6dp" />
            </LinearLayout>

            <!-- Блок 2: Системные требования -->
            <LinearLayout
                android:id="@+id/blockRequirements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/gradient_card_blue"
                android:padding="24dp"
                android:layout_marginBottom="16dp"
                android:visibility="invisible"
                android:elevation="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" СИСТЕМНЫЕ ТРЕБОВАНИЯ"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="К пользователю: нет, а зачем?\nК калькулятору: 2+2=5"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:lineSpacingExtra="6dp" />
            </LinearLayout>

            <!-- Кликабельная надпись вместо блока отзывов -->
            <TextView
                android:id="@+id/tvOpenChat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💬 Ваше мнение очень нас интересует"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="24dp"
                android:background="@drawable/gradient_card_gold"
                android:layout_marginBottom="16dp"
                android:elevation="8dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="invisible" />

            <!-- Подвал -->
            <TextView
                android:id="@+id/tvFooter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Гарантия: 0 дней\nПоддержка: отсутствует"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"
                android:visibility="invisible" />

            <!-- Кнопка закрытия с серой рамкой -->
            <Button
                android:id="@+id/btnClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Понятно, спасибо"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/btn_outline_gray"
                android:textColor="#FFFFFF"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:visibility="invisible" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>