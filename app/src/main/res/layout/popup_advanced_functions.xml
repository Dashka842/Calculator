<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="550dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/popup_bg"
    android:padding="20dp"
    android:elevation="16dp">

    <!-- Заголовок панели -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Дополнительные функции"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- === СТРАНИЦА 1: 3×3 === -->
    <GridLayout
        android:id="@+id/page1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="3"
        android:useDefaultMargins="true">

        <Button android:id="@+id/popupX2" android:background="@drawable/popup_button_bg" app:backgroundTint="@null" android:textColor="#FFFFFF" android:textSize="24sp" android:layout_width="0dp" android:layout_height="75dp" android:layout_columnWeight="1" android:text="x²" />
        <Button android:id="@+id/popupX3" android:background="@drawable/popup_button_bg" app:backgroundTint="@null" android:textColor="#FFFFFF" android:textSize="24sp" android:layout_width="0dp" android:layout_height="75dp" android:layout_columnWeight="1" android:text="x³" />
        <Button android:id="@+id/popupFact" android:background="@drawable/popup_button_bg" app:backgroundTint="@null" android:textColor="#FFFFFF" android:textSize="24sp" android:layout_width="0dp" android:layout_height="75dp" android:layout_columnWeight="1" android:text="n!" />

        <Button android:id="@+id/popupSqrt" android:background="@drawable/popup_button_bg" app:backgroundTint="@null" android:textColor="#FFFFFF" android:textSize="30sp" android:layout_width="0dp" android:layout_height="75dp" android:layout_columnWeight="1" android:text="√" />
        <Button android:id="@+id/popupSin" android:background="@drawable/popup_button_bg" app:backgroundTint="@null" android:textColor="#FFFFFF" android:textSize="20sp" android:layout_width="0dp" android:layout_height="75dp" android:layout_columnWeight="1" android:text="sin" />
        <Button android:id="@+id/popupCos" android:background="@drawable/popup_button_bg" app:backgroundTint="@null" android:textColor="#FFFFFF" android:textSize="20sp" android:layout_width="0dp" android:layout_height="75dp" android:layout_columnWeight="1" android:text="cos" />

        <Button android:id="@+id/popupTan" android:background="@drawable/popup_button_bg" app:backgroundTint="@null" android:textColor="#FFFFFF" android:textSize="20sp" android:layout_width="0dp" android:layout_height="75dp" android:layout_columnWeight="1" android:text="tan" />
        <Button android:id="@+id/popupLog" android:background="@drawable/popup_button_bg" app:backgroundTint="@null" android:textColor="#FFFFFF" android:textSize="20sp" android:layout_width="0dp" android:layout_height="75dp" android:layout_columnWeight="1" android:text="log" />
        <Button android:id="@+id/popupPi" android:background="@drawable/popup_button_bg" app:backgroundTint="@null" android:textColor="#FFFFFF" android:textSize="28sp" android:layout_width="0dp" android:layout_height="75dp" android:layout_columnWeight="1" android:text="π" />
    </GridLayout>

    <!-- === СТРАНИЦА 2: 3×3 === -->
    <GridLayout
        android:id="@+id/page2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="3"
        android:useDefaultMargins="true"
        android:visibility="gone">

        <Button android:id="@+id/popupAsin" android:background="@drawable/popup_button_bg" app:backgroundTint="@null" android:textColor="#FFFFFF" android:textSize="20sp" android:layout_width="0dp" android:layout_height="75dp" android:layout_columnWeight="1" android:text="arcsin" />
        <Button android:id="@+id/popupAcos" android:background="@drawable/popup_button_bg" app:backgroundTint="@null" android:textColor="#FFFFFF" android:textSize="20sp" android:layout_width="0dp" android:layout_height="75dp" android:layout_columnWeight="1" android:text="arccos" />
        <Button android:id="@+id/popupAtan" android:background="@drawable/popup_button_bg" app:backgroundTint="@null" android:textColor="#FFFFFF" android:textSize="20sp" android:layout_width="0dp" android:layout_height="75dp" android:layout_columnWeight="1" android:text="arctan" />

        <Button android:id="@+id/popupSinh" android:background="@drawable/popup_button_bg" app:backgroundTint="@null" android:textColor="#FFFFFF" android:textSize="22sp" android:layout_width="0dp" android:layout_height="75dp" android:layout_columnWeight="1" android:text="sh" />
        <Button android:id="@+id/popupCosh" android:background="@drawable/popup_button_bg" app:backgroundTint="@null" android:textColor="#FFFFFF" android:textSize="22sp" android:layout_width="0dp" android:layout_height="75dp" android:layout_columnWeight="1" android:text="ch" />
        <Button android:id="@+id/popupTanh" android:background="@drawable/popup_button_bg" app:backgroundTint="@null" android:textColor="#FFFFFF" android:textSize="22sp" android:layout_width="0dp" android:layout_height="75dp" android:layout_columnWeight="1" android:text="th" />

        <Button android:id="@+id/popupAbs" android:background="@drawable/popup_button_bg" app:backgroundTint="@null" android:textColor="#FFFFFF" android:textSize="24sp" android:layout_width="0dp" android:layout_height="75dp" android:layout_columnWeight="1" android:text="|x|" />
        <Button android:id="@+id/popupEx" android:background="@drawable/popup_button_bg" app:backgroundTint="@null" android:textColor="#FFFFFF" android:textSize="22sp" android:layout_width="0dp" android:layout_height="75dp" android:layout_columnWeight="1" android:text="eˣ" />
        <Button android:id="@+id/popupE" android:background="@drawable/popup_button_bg" app:backgroundTint="@null" android:textColor="#FFFFFF" android:textSize="28sp" android:layout_width="0dp" android:layout_height="75dp" android:layout_columnWeight="1" android:text="e" />
    </GridLayout>

    <!-- === НИЖНЯЯ ПАНЕЛЬ НАВИГАЦИИ === -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/btnPrevPage"
            android:background="@drawable/popup_button_bg"
            app:backgroundTint="@null"
            android:text="Назад"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnNextPage"
            android:background="@drawable/popup_button_bg"
            app:backgroundTint="@null"
            android:text="Далее"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp" />
    </LinearLayout>

</LinearLayout>