<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#1E1E1E">

    <!-- === ВЕРХНЯЯ ПАНЕЛЬ: Название и Шестеренка === -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Калькулятор"
            android:textColor="#AAAAAA"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="end"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/btnSettings"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="⚙"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Область дисплея -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="vertical"
        android:gravity="end|bottom"
        android:paddingBottom="16dp">

        <!-- Верхняя строка: выражение + стрелка истории -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end|center_vertical">

            <EditText
                android:id="@+id/tvExpression"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="end|top"
                android:textColor="#FFFFFF"
                android:textSize="42sp"
                android:textStyle="bold"
                android:maxLines="5"
                android:scrollbars="vertical"
                android:fadeScrollbars="false"
                android:overScrollMode="always"
                android:ellipsize="none"
                android:background="@android:color/transparent"
                android:cursorVisible="true"
                android:textCursorDrawable="@drawable/cursor_white"
                android:textIsSelectable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:inputType="none"
                android:importantForAutofill="no"
                android:padding="0dp"
                android:layout_margin="0dp" />

            <TextView
                android:id="@+id/tvHistoryArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↩"
                android:textColor="#FF9500"
                android:textSize="32sp"
                android:visibility="gone"
                android:paddingStart="12dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Нижняя строка: предварительный ответ -->
        <TextView
            android:id="@+id/tvDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="0"
            android:textColor="#888888"
            android:textSize="28sp"
            android:maxLines="1"
            android:layout_marginBottom="10dp" />

        <!-- Кнопки: f(x), ^, ° слева, удаление справа -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Левая часть: f(x), степень и градус -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="start">

                <TextView
                    android:id="@+id/btnAdvancedToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="f(x)"
                    android:textColor="#FF9500"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless" />

                <TextView
                    android:id="@+id/btnPower"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="^"
                    android:textColor="#FF9500"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:padding="8dp"
                    android:layout_marginStart="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless" />

                <!-- Кнопка градуса (скрыта по умолчанию) -->
                <TextView
                    android:id="@+id/btnDegree"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="°"
                    android:textColor="#FF9500"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:padding="8dp"
                    android:layout_marginStart="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Правая часть: кнопка удаления -->
            <TextView
                android:id="@+id/btnBackSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌫"
                android:textColor="#FF9500"
                android:textSize="28sp"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

    </LinearLayout> <!-- === ВОТ ЭТОГО ТЕГА НЕ ХВАТАЛО! === -->

    <!-- Сетка кнопок (5 рядов) -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:columnCount="4"
        android:rowCount="5"
        android:useDefaultMargins="false">

        <!-- Ряд 1: C, (), ANS, ÷ -->
        <Button android:id="@+id/btnClear"   style="@style/CalcButtonGray" android:text="C" />
        <Button android:id="@+id/btnBracket" style="@style/CalcButtonGray" android:text="()" android:textSize="28sp" />
        <Button
            android:id="@+id/btnAns"
            style="@style/CalcButtonGray"
            android:text="ANS"
            android:textSize="14sp"
            android:singleLine="true"
            android:enabled="false"
            android:alpha="0.5" />
        <Button android:id="@+id/btnDiv"     style="@style/CalcButtonOrange" android:text="÷" />

        <!-- Ряд 2 -->
        <Button android:id="@+id/btn7" style="@style/CalcButton" android:text="7" />
        <Button android:id="@+id/btn8" style="@style/CalcButton" android:text="8" />
        <Button android:id="@+id/btn9" style="@style/CalcButton" android:text="9" />
        <Button android:id="@+id/btnMul" style="@style/CalcButtonOrange" android:text="×" />

        <!-- Ряд 3 -->
        <Button android:id="@+id/btn4" style="@style/CalcButton" android:text="4" />
        <Button android:id="@+id/btn5" style="@style/CalcButton" android:text="5" />
        <Button android:id="@+id/btn6" style="@style/CalcButton" android:text="6" />
        <Button android:id="@+id/btnSub" style="@style/CalcButtonOrange" android:text="−" />

        <!-- Ряд 4 -->
        <Button android:id="@+id/btn1" style="@style/CalcButton" android:text="1" />
        <Button android:id="@+id/btn2" style="@style/CalcButton" android:text="2" />
        <Button android:id="@+id/btn3" style="@style/CalcButton" android:text="3" />
        <Button android:id="@+id/btnAdd" style="@style/CalcButtonOrange" android:text="+" />

        <!-- Ряд 5 -->
        <Button
            android:id="@+id/btn0"
            style="@style/CalcButton"
            android:text="0"
            android:layout_columnSpan="2"
            android:layout_columnWeight="2"
            android:layout_gravity="fill_horizontal" />
        <Button android:id="@+id/btnDot"  style="@style/CalcButton" android:text="." />
        <Button android:id="@+id/btnEqual" style="@style/CalcButtonOrange" android:text="=" />
    </GridLayout>
</LinearLayout>