<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="#1E1E1E">

    <!-- ЛЕВАЯ ЧАСТЬ: Дисплей (занимает 1 часть экрана) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:orientation="vertical"
        android:gravity="end|bottom"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <!-- Верхняя строка: выражение + стрелка истории -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end|center_vertical">

            <EditText
                android:id="@+id/tvExpression"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="#FFFFFF"
                android:textSize="42sp"
                android:textStyle="bold"
                android:maxLines="3"
                android:scrollbars="vertical"
                android:fadeScrollbars="false"
                android:ellipsize="none"
                android:background="@android:color/transparent"
                android:cursorVisible="true"
                android:textCursorDrawable="@drawable/cursor_white"
                android:textIsSelectable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:inputType="none"
                android:importantForAutofill="no"
                android:padding="0dp"
                android:layout_margin="0dp" />

            <TextView
                android:id="@+id/tvHistoryArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↩"
                android:textColor="#FF9500"
                android:textSize="32sp"
                android:visibility="gone"
                android:paddingStart="12dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Нижняя строка: предварительный ответ -->
        <TextView
            android:id="@+id/tvDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="0"
            android:textColor="#888888"
            android:textSize="32sp"
            android:maxLines="1"
            android:scrollHorizontally="true"
            android:ellipsize="end"
            android:layout_marginBottom="12dp" />

        <!-- Кнопка удаления -->
        <TextView
            android:id="@+id/btnBackSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="⌫"
            android:textColor="#FF9500"
            android:textSize="28sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- ПРАВАЯ ЧАСТЬ: Сетка кнопок (занимает 2 части экрана) -->
    <GridLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.5"
        android:columnCount="4"
        android:rowCount="5"
        android:useDefaultMargins="false"
        android:alignmentMode="alignMargins">

        <!-- Ряд 1 -->
        <Button android:id="@+id/btnClear"   style="@style/CalcButtonGray" android:text="C" />
        <Button android:id="@+id/btnBracket" style="@style/CalcButtonGray" android:text="()" android:textSize="28sp" />
        <Button android:id="@+id/btnAns"     style="@style/CalcButtonGray" android:text="ANS" android:textSize="16sp" android:enabled="false" android:alpha="0.5" />
        <Button android:id="@+id/btnDiv"     style="@style/CalcButtonOrange" android:text="÷" />

        <!-- Ряд 2 -->
        <Button android:id="@+id/btn7" style="@style/CalcButton" android:text="7" />
        <Button android:id="@+id/btn8" style="@style/CalcButton" android:text="8" />
        <Button android:id="@+id/btn9" style="@style/CalcButton" android:text="9" />
        <Button android:id="@+id/btnMul" style="@style/CalcButtonOrange" android:text="×" />

        <!-- Ряд 3 -->
        <Button android:id="@+id/btn4" style="@style/CalcButton" android:text="4" />
        <Button android:id="@+id/btn5" style="@style/CalcButton" android:text="5" />
        <Button android:id="@+id/btn6" style="@style/CalcButton" android:text="6" />
        <Button android:id="@+id/btnSub" style="@style/CalcButtonOrange" android:text="−" />

        <!-- Ряд 4 -->
        <Button android:id="@+id/btn1" style="@style/CalcButton" android:text="1" />
        <Button android:id="@+id/btn2" style="@style/CalcButton" android:text="2" />
        <Button android:id="@+id/btn3" style="@style/CalcButton" android:text="3" />
        <Button android:id="@+id/btnAdd" style="@style/CalcButtonOrange" android:text="+" />

        <!-- Ряд 5 -->
        <Button
            android:id="@+id/btn0"
            style="@style/CalcButton"
            android:text="0"
            android:layout_columnSpan="2"
            android:layout_columnWeight="2"
            android:layout_gravity="fill_horizontal" />
        <Button android:id="@+id/btnDot"  style="@style/CalcButton" android:text="." />
        <Button android:id="@+id/btnEqual" style="@style/CalcButtonOrange" android:text="=" />
    </GridLayout>
</LinearLayout>